<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US">

  <info>
    <title>Used by package list</title>
    <id>https://example.com/used-by-package-list</id>
    <updated>2026-07-31T00:00:00+00:00</updated>
  </info>

  <macro name="author-short">
    <names variable="author"
           et-al-min="2"
           et-al-use-first="1">
      <name form="short"/>
      <et-al term="et-al"/>
      <substitute>
        <names variable="editor"
               et-al-min="2"
               et-al-use-first="1">
          <name form="short"/>
          <et-al term="et-al"/>
        </names>
        <text value="Unknown author"/>
      </substitute>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <citation>
    <layout>
      <text macro="author-short"/>
      <text value=" "/>
      <text macro="year"/>
    </layout>
  </citation>

  <bibliography et-al-min="2" et-al-use-first="1">
    <sort>
      <key variable="issued" sort="descending"/>
      <key macro="author-short"/>
      <key variable="title"/>
    </sort>

    <layout suffix=".">
      <text macro="author-short"/>
      <text value=". "/>

      <text macro="year"/>
      <text value=". "/>

      <text variable="title"/>
      <text value=". "/>

      <choose>
        <if variable="DOI">
          <text variable="DOI" prefix="https://doi.org/"/>
        </if>
        <else-if variable="URL">
          <text variable="URL"/>
        </else-if>
      </choose>
    </layout>
  </bibliography>

</style>
